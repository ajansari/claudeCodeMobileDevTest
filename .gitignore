### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json only (may hold tenant/connection details); .vscode/settings.json stays tracked —
#OCPF Step 05 puts the required analyzer settings there and it must ship with the project.
.vscode/launch.json
#Cache folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-files
*.bclicense
*.flf
#Test results file
TestResults.xml

### OCPF Agentic Dev Framework ###
#Companion guides (fetched from framework repo, not project deliverables)
standardsGuide/
opsGuide/
#Per-developer notification settings (always ignored)
.ocpf/notifications.json
#AL MCP launcher + analyzer-compile scripts (fetched byte-for-byte from the framework repo)
scripts/
#OCPF BC AL Patterns library (fetched from ajansari/ocpfBCALPatterns, refreshed on request)
patterns/